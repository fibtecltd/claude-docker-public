# Copy to .env and add your key. Never commit .env.
# Read by `docker compose` (see docker-compose.yml).

# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which plugin set to load (core, pyvar or a profile you add). Default: core.
# CLAUDE_PROFILE=pyvar

# Optional: GitHub access inside the container. Use a token scoped to only the
# repositories a run needs; with permission checks bypassed, whatever the token
# can do, Claude can do.
# GITHUB_PERSONAL_ACCESS_TOKEN=   # the github plugin's MCP server
# GITHUB_TOKEN=                   # the gh CLI
